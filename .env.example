# Vorlage für .env.local (nie ins Repository; .gitignore schließt sie aus).
# Kopieren mit: Copy-Item .env.example .env.local – dann hinter jedes = den Wert eintragen.

# Supabase (ab P4a). Beide Werte sind öffentlich: Supabase-Dashboard → Project Settings → API Keys.
# Ab P4b braucht `npm run dev` beide (Anmeldung beim echten Projekt); `npm run demo` und `npm run check` nicht.
# Geheime Schlüssel (secret / service_role) und das Datenbank-Passwort gehören NICHT hierher.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Nur für `npm run try:sources` (P2) auf deinem PC. Auf dem Server liegen sie als Supabase-Secrets.
REBRICKABLE_API_KEY=
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN_VALUE=
BRICKLINK_TOKEN_SECRET=
